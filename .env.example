# Copy to .env — PayPal sandbox app: developer.paypal.com → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id (Webhooks → add https://<your-public-url>/api/webhook, e.g. via ngrok)
PAYPAL_WEBHOOK_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
STATIC_DIR=.
