# Template only. Copy to the ignored local .env and place secrets there; never paste secrets here.
# PayPal sandbox app: developer.paypal.com → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# Invoice delivery remains local and explicitly simulated until live sending is verified.
PAYPAL_INVOICE_SEND_MODE=simulated
# Optional: webhook id (Webhooks → add https://<your-public-url>/api/webhook, e.g. via ngrok)
PAYPAL_WEBHOOK_ID=
# LLM configuration (Gemini free-tier Flash-Lite is the default).
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
# Conservative local ceilings. Google quotas are project-specific; lower these if AI Studio shows less.
AI_DAILY_USER_LIMIT=5
AI_DAILY_ORG_LIMIT=20
AI_MAX_INPUT_CHARS=1000
AI_MAX_OUTPUT_TOKENS=400
AI_CACHE_TTL_SECONDS=300
# Rule-based anomaly defaults: 2x fee rate, 3 prior captures, 10m duplicate/stale windows, 25% refund rate, $10,000 payout.
ANOMALY_FEE_SPIKE_MULTIPLIER=2
ANOMALY_FEE_SPIKE_MIN_SAMPLES=3
ANOMALY_DUPLICATE_WINDOW_MINUTES=10
ANOMALY_REFUND_RATE_THRESHOLD=0.25
ANOMALY_LARGE_PAYOUT_MINOR=1000000
ANOMALY_STALE_WEBHOOK_MINUTES=10
ANOMALY_SCAN_INTERVAL_MS=21600000
# Optional Anthropic adapter. Set LLM_PROVIDER=anthropic to enable it.
# LLM_API_KEY=your-anthropic-api-key
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
STATIC_DIR=.
# Supabase (free project; omit all three to run in explicit degraded mode).
SUPABASE_URL=
# Legacy anon key or current sb_publishable key; safe to expose via public-config.
SUPABASE_ANON_KEY=
# Legacy service_role JWT or current sb_secret key; server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 5 document OCR and processing limits. Provider credentials are server-only.
# GEMINI_API_KEY
DOCUMENT_OCR_MODEL=gemini-3.5-flash-lite
DOCUMENT_MAX_FILE_MB=10
DOCUMENT_MAX_PAGES=10
DOCUMENT_MAX_CONCURRENT_JOBS_PER_ORG=2
DOCUMENT_MAX_UPLOADS_PER_ORG_PER_HOUR=20
